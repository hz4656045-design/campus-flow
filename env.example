# =============================================================================
# Campus Flow — Environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- App --------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_NAME=campus-flow

# --- Database ---------------------------------------------------------------
# Used by Prisma and the application. Same connection string for both.
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_flow?schema=public

# --- Auth / JWT -------------------------------------------------------------
# Access tokens: short-lived (15 min). Refresh tokens: 7 days.
JWT_ACCESS_SECRET=replace-with-32+char-random-string-please
JWT_REFRESH_SECRET=replace-with-a-different-32+char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=campus-flow

# Cookie settings for refresh token (HttpOnly, Secure in prod, SameSite=Strict)
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# --- Password hashing -------------------------------------------------------
BCRYPT_COST=12

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
