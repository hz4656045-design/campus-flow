# =============================================================================
# Campus Flow — Example environment configuration
# Copy this file to .env (exact name, with the leading dot) and fill in real
# values. NEVER commit .env.
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=campus-flow

# --- Database ----------------------------------------------------------------
# Used by Prisma and the application. Same connection string for both.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# If your password has special characters (@ : / # ?), URL-encode them.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/campus_flow?schema=public"

# --- Auth / JWT --------------------------------------------------------------
# Access tokens: short-lived (15 min). Refresh tokens: 7 days.
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=campus-flow

# Cookie settings for refresh token (HttpOnly; Secure in prod; SameSite=lax|strict|none)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Password hashing --------------------------------------------------------
BCRYPT_COST=12

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- CORS / proxy ------------------------------------------------------------
# Comma-separated allowed origins. Required in production.
CORS_ORIGINS=http://localhost:5173
# Set to 1 when behind nginx / a load balancer
# TRUST_PROXY=1

# --- Startup behaviour -------------------------------------------------------
# Set to 1 to crash the process if PostgreSQL is unreachable on boot.
# Defaults to off in development (server starts in degraded mode; /health/ready
# reports the database as down).
# FAIL_ON_DB_ERROR=1

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=debug

# --- Seed (optional) ---------------------------------------------------------
# Admin bootstrap user created by `npm run prisma:seed`
# ADMIN_EMAIL=admin@campusflow.edu
# ADMIN_PASSWORD=ChangeMe!Strong123
